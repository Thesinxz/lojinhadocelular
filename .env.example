# Variáveis de ambiente — Lojinha do Celular
# Copie este arquivo para .env e preencha com os valores do SEU servidor.

# Banco de dados MySQL (ex: mysql://usuario:senha@host:3306/banco)
DATABASE_URL=

# Segredo usado para assinar os tokens do painel admin (gere uma string aleatória longa)
APP_SECRET=

# Integração ERP Gestão Celular (Storefront Catalog — Somente Leitura)
# IMPORTANTE: A API oficial exige o subdomínio "api." (https://api.gestaocelular.com.br)
ERP_API_URL=https://api.gestaocelular.com.br
ERP_STORE_SLUG=lojinha-do-celular-mplnk5d6
ERP_CATEGORY_SLUG=aparelhos-celulares
ERP_CATALOG_ENABLED=true

# Hospedagem de Imagens dos Aparelhos no Cloudflare R2 (Compatível com S3)
# Opcional: Se preenchido, os iPhones serão servidos diretamente da CDN Cloudflare R2.
# Exemplo: https://pub-xxxxxxxxxxxxxxxx.r2.dev ou https://cdn.lojinhadocelular.com
VITE_CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_URL=

# Credenciais para execução do script de upload para Cloudflare R2 (scripts/sync_to_r2.py)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lojinha-images

